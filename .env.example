DATABASE_URL=pglite://.data/gia-v3
# Relative V3 URLs are resolved from the PROJECT ROOT (pnpm-workspace.yaml),
# never from process.cwd(). Safe with pnpm --filter / artifacts/api-server.
#
# Canonical absolute production path (Windows example):
#   D:/gia-shawarma-manager-self-host/.data/gia-v3
#
# Official local start (recommended):
#   pnpm run dev:v3
#   or double-click START-GIA-V3.bat
#
# V2 legacy (do not use for V3):
# DATABASE_URL=pglite://.data/gia-shawarma
#
# V3 automated tests MUST use (forced in tests / test:v3):
# DATABASE_URL=pglite://.data/gia-v3-test
PORT=5000

# Auth (change before production)
AUTH_SECRET=change-me-in-production
AUTH_ADMIN_USER=admin
# Development-only default. In production (NODE_ENV=production) AUTH_ADMIN_PASSWORD is REQUIRED to seed the first admin.
AUTH_ADMIN_PASSWORD=admin123
AUTH_ADMIN_NAME=Owner

# Optional override if the monorepo root cannot be discovered:
# GIA_PROJECT_ROOT=D:/gia-shawarma-manager-self-host

# Recommended for shared/dev with Docker Postgres:
# 1) pnpm run dev:db
# 2) DATABASE_URL=postgresql://gia_user:gia_local_dev@127.0.0.1:5432/gia_shawarma
#    PORT=5000 pnpm --filter @workspace/api-server run start
#
# For production PostgreSQL:
# DATABASE_URL=postgresql://gia_user:your-password@127.0.0.1:5432/gia_shawarma
